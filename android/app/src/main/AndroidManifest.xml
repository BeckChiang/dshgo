<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 访问 Mac 上的 dsh web：HTTP + WebSocket，同一权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 扫二维码填地址。声明为「非必需」，没相机的设备照样能装（手输地址）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      语音输入用。SpeechRecognizer 需要它 —— 原来走系统识别界面时不需要，
      但那条路在 ColorOS 上走不通（没有 Activity 处理 RECOGNIZE_SPEECH），
      改成直接用识别服务 API 后就必须有了。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 应用内更新：下载完直接把安装器拉起来，不用让用户去文件管理器找 apk。
         注意这只是"允许发起安装"，真正的安装确认仍然必须由用户点一下 ——
         这是 Android 的硬性要求，绕不过。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ 发系统通知要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机后自动恢复监听（否则重启手机后就再也收不到完成通知） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 保活：后台也要能收到「会话跑完了」，否则进程被冻结就收不到 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API < 29 下载到公共 Downloads 目录才需要；29+ 走 MediaStore 免权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    
    <!--
      Android 11 起必须声明才能"看见"别的应用。
      不声明的话 resolveActivity() 一律返回 null —— 表现为"明明有语音识别，
      App 却说这台设备没有"。同理也会影响扫码、打开浏览器这些跳转的判定。

      注意：只声明我们真的要跳过去的那几个 action，不做宽泛匹配。
    -->
    <queries>
        <!-- 语音输入 -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- 打开下载页 / 系统设置 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

<application
        android:name=".DshApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- 从别的应用分享进来：图片暂存，等用户在 DSH 里点附件时直接交出去。
                 文字不用另加过滤器 —— 下面已经有一个 text/plain 的。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 在别处（微信/备忘录/设置页）复制的 pocket 链接，直接「分享到 DSH」即可填地址 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 独立的 Tailscale 页面：登录/启用隧道/退出登录与连接地址解耦，
             避免「切地址 → 重连」把登录态和隧道状态一起搅乱。 -->
        <activity
            android:name=".ui.TunnelLoginActivity"
            android:exported="false"
            android:label="@string/tunnel_page_title"
            android:theme="@style/AppTheme" />

        <service
            android:name=".WatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 小组件会话列表的集合视图数据源（RemoteViewsService）。
             BIND_REMOTEVIEWS 权限是系统要求的：只有桌面启动器能绑定它，
             普通 App 绑不上；exported=true 是必须的，否则列表永远空白。 -->
        <service
            android:name=".notify.WidgetListService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 工作区选择页的集合视图数据源，同上。 -->
        <service
            android:name=".notify.WorkspaceListService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 定时任务组件的数据源。之前漏注册了这个 service：
             头部数量由 provider 直接 setText 能显示，但列表绑定失败 → 一行都不显示。 -->
        <service
            android:name=".notify.ScheduleListService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 内嵌 Tailscale（阶段 4）：引擎跑在本进程，隧道由我们自己的 VpnService 建立。
             只放行本应用到隧道里（addAllowedApplication），不影响手机其他 App。 -->
        <service
            android:name="com.dsh.remote.TailscaleVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Android 14+ 要求前台服务声明类型：不声明时 startForeground() 直接抛
                 MissingForegroundServiceTypeException，表现就是「一开 VPN 就闪退」。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn-tunnel" />
        </service>


    
        <!-- 开机后把保活服务拉回来：只补「重启之后通知就不来了」这一段。 -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 审批通知的两个动作按钮。用广播而不是 Activity：点「允许」不该把
             App 拉到前台 —— 用户的意图只是让 agent 继续跑。 -->
        <receiver
            android:name=".notify.ApprovalReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dshgo.app.APPROVE" />
                <action android:name="com.dshgo.app.REJECT" />
            </intent-filter>
        </receiver>

        <!-- 主屏小组件：一眼看状态 + 两个动作 -->
        <receiver
            android:name=".notify.DshWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 定时任务小组件：同一个 App，另一种视图 -->
        <receiver
            android:name=".notify.ScheduleWidgetProvider"
            android:exported="false"
            android:label="@string/widget_schedule_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_info" />
        </receiver>

        <!-- 把下好的 apk 交给系统安装器。Android 7 起 file:// 不能跨进程，
             只能用 content:// + 临时读权限。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 自己被更新之后会收到这个广播。用它补一条"已更新，点此打开"的通知 ——
             安装器那边本来就有「打开」按钮，但用户要是先按了返回，这条能把他接回来。 -->
        <receiver
            android:name=".notify.UpdateInstalledReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
</application>

</manifest>
