<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件用的颜色。

  取值来自 App 自己的 DshColor（那份又是对齐 DSH 界面抄的）——
  小组件是主屏上唯一露出的品牌面，不能是另一套野色。

  每个语义名在这里给浅色值，深色值在 values-night/colors.xml。
-->
<resources>
    <!-- 应用图标底：官方 logo 是白底上的灰 F + 蓝色块，背景就用白，前景走 mipmap 位图。 -->
    <color name="ic_launcher_bg">#FFFFFFFF</color>
    <!-- 卡片 -->
    <color name="wg_card">#FFFFFFFF</color>
    <color name="wg_card_border">#FFE6E9EF</color>

    <!-- 文字 -->
    <color name="wg_title">#FF10141C</color>
    <color name="wg_detail">#FF5B6472</color>

    <!-- 主按钮：DeepSeek 品牌蓝 -->
    <color name="wg_primary">#FF4D6BFE</color>
    <color name="wg_primary_end">#FF3F5BEE</color>
    <color name="wg_on_primary">#FFFFFFFF</color>

    <!-- 次按钮 -->
    <color name="wg_ghost">#FFF7F8FA</color>
    <color name="wg_ghost_border">#FFE6E9EF</color>
    <color name="wg_ghost_text">#FF10141C</color>

    <!-- 状态点 -->
    <color name="wg_dot_running">#FF22C55E</color>
    <color name="wg_dot_approval">#FFF59E0B</color>
    <color name="wg_dot_idle">#FF98A1B0</color>

    <!-- 会话列表：工作区胶囊、行分割线、余额标签 -->
    <color name="wg_pill_bg">#FFF2F4F8</color>
    <color name="wg_pill_text">#FF10141C</color>
    <color name="wg_divider">#FFEDF0F5</color>
    <color name="wg_balance_label">#FF98A1B0</color>
    <!-- 未选中的工作区胶囊文字；选中的用 wg_pill_text -->
    <color name="wg_chip_text">#FF6B7484</color>
    <!-- 上下文占比：比标题弱一档，但要能读 -->
    <color name="wg_pct">#FF7C8595</color>
    <!-- 等审批行的浅橙底与文字色：只在这一类行上用，不参与主题切换以外的任何语义 -->
    <color name="wg_alert_bg">#1AF97316</color>
    <color name="wg_alert_text">#FFC2410C</color>

    <!--
      窗口底色（AppCompat 之外的 framework 主题用）。

      它是「页面还没画出来」时唯一看得见的东西：冷启动首帧、生物识别弹窗盖上来那一瞬、
      切换通道重新 loadUrl 的空档。以前写死 @android:color/white，深色下就闪一屏白。
      浅色值与 DshColor 的 SurfaceLight 对齐，深色值在 values-night/colors.xml。
    -->
    <color name="app_bg">#FFF4F6F9</color>
</resources>
