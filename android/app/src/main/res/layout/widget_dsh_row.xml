<?xml version="1.0" encoding="utf-8"?>
<!--
  一条会话：状态点 + 标题（单行省略）+ 右侧上下文占比，标题下方一行摘要。
  行尾自带 1dp 分割线；最后一行由 provider 置 GONE，免得卡片底部多出一条悬空线。
  注意：分割线必须是 TextView（RemoteViews 不支持 <View>）。
  摘要行由 provider 按数据有无决定 GONE/VISIBLE —— 没有摘要时行高自动回落，不会留白。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/widget_row_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_idle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/wg_title"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_row_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/wg_pct"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_row_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:textColor="@color/wg_pct"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="17dp"
        android:background="@color/wg_divider" />
</LinearLayout>
