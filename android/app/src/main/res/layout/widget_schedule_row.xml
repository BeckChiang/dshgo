<?xml version="1.0" encoding="utf-8"?>
<!-- 定时任务的一行：标题 / 关联工作区·会话 / 右侧时间或状态。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="5dp"
    android:paddingEnd="0dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_schedule_row_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_running" />

        <TextView
            android:id="@+id/widget_schedule_row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/wg_title"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/widget_schedule_row_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/wg_detail"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_schedule_row_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/wg_balance_label"
        android:textSize="10.5sp" />
</LinearLayout>
