<?xml version="1.0" encoding="utf-8"?>
<!--
  会话小组件（3×2）。

  RemoteViews 只支持有限的一组视图，且**不能**用 <View>/<Space> 占位，
  所以所有「空隙」都用带 weight 的空 TextView，分割线用 1dp 高的 TextView。
  颜色全部走 @color 资源：res/values-night 下有同名定义，系统深色模式自动切换，
  代码里不需要判断 uiMode。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- 头部：鲸鱼 + 工作区切换条（每个工作区一个胶囊，点谁切谁） / 右侧余额 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_whale"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginEnd="7dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_whale" />

        <!-- 工作区切换条：由一个 chip 换成一排 chip，工作区多了也点得到 -->
        <LinearLayout
            android:id="@+id/widget_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <!-- 兜底：一个工作区都不认识时仍显示一个不可点的标题 -->
        <TextView
            android:id="@+id/widget_workspace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:ellipsize="end"
            android:maxWidth="132dp"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textColor="@color/wg_pill_text"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 弹性空隙：RemoteViews 不支持 Space，用空 TextView 顶开余额 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 手动刷新：点一下强制拉一次快照（15s 心跳之外的手动档） -->
        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/widget_refresh_desc"
            android:src="@drawable/ic_widget_refresh" />

        <LinearLayout
            android:id="@+id/widget_balance_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_balance"
                android:textColor="@color/wg_balance_label"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_balance_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/wg_title"
                android:textSize="14sp"
                android:textStyle="bold" />
            <!-- 高峰/低峰小字：由 provider 填，副标题为空时隐藏 -->
    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/wg_detail"
        android:textSize="9.5sp"
        android:visibility="gone" />

</LinearLayout>
    </LinearLayout>

    <!-- 会话行容器：由 provider 用 addView 逐条塞进 widget_dsh_row -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical" />

    <!-- 没有可显示的数据时的降级文案（不显示 0 / 假数据） -->
    <TextView
        android:id="@+id/widget_fallback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/wg_detail"
        android:textSize="11.5sp"
        android:visibility="gone" />
</LinearLayout>
