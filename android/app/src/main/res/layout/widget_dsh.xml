<?xml version="1.0" encoding="utf-8"?>
<!--
  会话小组件（3×2）。

  RemoteViews 只支持有限的一组视图，且**不能**用 <View>/<Space> 占位，
  所以所有「空隙」都用带 weight 的空 TextView，分割线用 1dp 高的 TextView。
  颜色全部走 @color 资源：res/values-night 下有同名定义，系统深色模式自动切换。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="9dp">

    <!-- 头部：鲸鱼 + 工作区切换条（点谁切谁） / 右侧刷新 + 余额 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_whale"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="7dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_whale" />

        <!-- 工作区切换条：一个工作区一枚胶囊，点谁切谁 -->
        <LinearLayout
            android:id="@+id/widget_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <!-- 兜底：一个工作区都不认识时仍显示一个不可点的标题 -->
        <TextView
            android:id="@+id/widget_workspace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:ellipsize="end"
            android:maxWidth="132dp"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textColor="@color/wg_pill_text"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 弹性空隙：RemoteViews 不支持 Space，用空 TextView 顶开 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 手动刷新：点一下强制拉一次快照 -->
        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/widget_refresh_desc"
            android:src="@drawable/ic_widget_refresh" />

        <!-- 余额：只显示数字，不带货币符号与「余额」标签 -->
        <TextView
            android:id="@+id/widget_balance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/wg_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 隐藏占位，避免旧布局 id 丢失导致 provider 引用失败 -->
        <LinearLayout
            android:id="@+id/widget_balance_box"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 第一页：会话列表。集合视图才能滚动（普通 LinearLayout 塞几行就是几行），
         高度必须走 layout_weight —— 写 wrap_content 在部分启动器上会塌成 0 高。 -->
    <LinearLayout
        android:id="@+id/widget_page_sessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <!-- 底部余量垫片：RemoteViews 不能动态设高度，所以预置几档，
             由 provider 按「可用高度 − 整数行」选一档显示，卡片边缘就不会露半截行。 -->
        <TextView
            android:id="@+id/widget_row_pad0"
            android:layout_width="match_parent"
            android:layout_height="0dp" />
        <TextView
            android:id="@+id/widget_row_pad1"
            android:layout_width="match_parent"
            android:layout_height="8dp" />
        <TextView
            android:id="@+id/widget_row_pad2"
            android:layout_width="match_parent"
            android:layout_height="16dp" />
        <TextView
            android:id="@+id/widget_row_pad3"
            android:layout_width="match_parent"
            android:layout_height="24dp" />
        <TextView
            android:id="@+id/widget_row_pad4"
            android:layout_width="match_parent"
            android:layout_height="32dp" />
        <TextView
            android:id="@+id/widget_row_pad5"
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- 第二页：工作区选择。工作区多少都不怕，同样是可滚动的集合视图。 -->
    <LinearLayout
        android:id="@+id/widget_page_workspaces"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_workspace_title"
                android:textColor="@color/wg_detail"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_ws_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="2dp"
                android:text="@string/widget_back"
                android:textColor="@color/wg_pill_text"
                android:textSize="11sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/widget_ws_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- 没有可显示的数据时的降级文案（不显示 0 / 假数据） -->
    <TextView
        android:id="@+id/widget_fallback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/wg_detail"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- 底栏：左边「N 个在跑」，右边「高峰 / 低峰」 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_running"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/wg_detail"
            android:textSize="9.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/wg_detail"
            android:textSize="9.5sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
