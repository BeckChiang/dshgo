<?xml version="1.0" encoding="utf-8"?>
<!-- 等审批的行：整行浅橙底，和普通行同一套尺寸，只换背景与状态色。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_alert"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_row_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_approval" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/wg_title"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_row_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="@color/wg_pct"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/wg_alert_text"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_row_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textColor="@color/wg_alert_text"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
